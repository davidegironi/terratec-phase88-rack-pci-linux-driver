+/* temporary Phase88 diagnostics - enabled with module parameter diag=1 */
+static bool diag;
+module_param(diag, bool, 0444);
+MODULE_PARM_DESC(diag, "Phase88/EWS88 I2C + GPIO bring-up diagnostics");
