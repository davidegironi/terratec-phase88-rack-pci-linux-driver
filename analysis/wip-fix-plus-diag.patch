-	if (ndata != data)
-		if (snd_i2c_sendbytes(spec->i2cdevs[EWS_I2C_PCF2], &ndata, 1)
-		    != 1)
+	if (ndata != data) {
+		err = snd_i2c_sendbytes(spec->i2cdevs[EWS_I2C_PCF2], &ndata, 1);
+		if (err != 1)
 			goto __error;
+	}
 	snd_i2c_unlock(ice->i2c);
