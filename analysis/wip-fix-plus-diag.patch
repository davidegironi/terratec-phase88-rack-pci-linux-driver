+/*
+ * Read-only bus observation.  The addresses below are the only ones that
+ * appear in the Linux driver or in the Terratec Windows driver: the WDM
+ * driver probes 8-bit 0x20, 0x44, 0x48 and 0x42 (see analysis/README.md).
+ * snd_i2c_probeaddr() only performs START + address(W) + STOP, i.e. no
+ * data is transferred to or from any device.
+ */
+static const unsigned char ews88_probe_addrs[] = {
+	0x10,	/* 8-bit 0x20 - probed by the Windows driver */
+	0x20,	/* 8-bit 0x40 - CS8404 (Linux EWS88MT/Phase88) */
+	0x21,	/* 8-bit 0x42 - Windows "type 8" chip select (PHASE 88) */
+	0x22,	/* 8-bit 0x44 - Windows "type 4" */
+	0x23,	/* 8-bit 0x46 - Linux EWS88MT input expander */
+	0x24,	/* 8-bit 0x48 - Linux EWS88MT/Phase88 output expander */
+	0x25,	/* 8-bit 0x4a - probed by the Windows driver */
+	0x27,	/* 8-bit 0x4e - probed by the Windows driver */
+};
+
+static void snd_ice1712_ews88_diag(struct snd_ice1712 *ice)
+{
+	struct snd_i2c_device *tmp;
+	unsigned char val;
+	int i, err;
+
+	snd_ice1712_save_gpio_status(ice);
+	dev_info(ice->card->dev,
+		"diag: GPIO data=%02x wmask=%02x dir=%02x (eeprom mask=%02x state=%02x dir=%02x)\n",
+		snd_ice1712_read(ice, ICE1712_IREG_GPIO_DATA),
+		snd_ice1712_read(ice, ICE1712_IREG_GPIO_WRITE_MASK),
+		snd_ice1712_read(ice, ICE1712_IREG_GPIO_DIRECTION),
+		ice->eeprom.gpiomask, ice->eeprom.gpiostate, ice->eeprom.gpiodir);
+	snd_ice1712_restore_gpio_status(ice);
+
+	snd_i2c_lock(ice->i2c);
+	for (i = 0; i < ARRAY_SIZE(ews88_probe_addrs); i++) {
+		err = snd_i2c_probeaddr(ice->i2c, ews88_probe_addrs[i]);
+		dev_info(ice->card->dev,
+			 "diag: addr 7bit 0x%02x (8bit 0x%02x): %s\n",
+			 ews88_probe_addrs[i], ews88_probe_addrs[i] << 1,
+			 err ? "NACK" : "ACK");
+		if (!err &&
+		    snd_i2c_device_create(ice->i2c, "diag", ews88_probe_addrs[i],
+					  &tmp) == 0) {
+			val = 0xaa;
+			err = snd_i2c_readbytes(tmp, &val, 1);
+			dev_info(ice->card->dev,
+				 "diag:   readbyte 7bit 0x%02x -> %d (0x%02x)\n",
+				 ews88_probe_addrs[i], err, err == 1 ? val : 0);
+			snd_i2c_device_free(tmp);
+		}
+	}
+	snd_i2c_unlock(ice->i2c);
+}
+
+/*
+ * PHASE 88 AK4524 chip select
+ *
+ * Contrary to the EWS88MT the chip select byte of the PHASE 88 cannot be
+ * read back: the expander is only ever written by the original Windows
+ * driver, which composes the byte from its own state.  Therefore keep a
+ * shadow copy of the flag bits and always write the complete value.
+ */
+static int snd_ice1712_phase88_chip_select(struct snd_ice1712 *ice, int chip_mask)
+{
+	struct ews_spec *spec = ice->spec;
+	unsigned char bytes[2];
+	int err;
+
+	if (snd_BUG_ON(chip_mask < 0 || chip_mask > 0x0f))
+		return -EINVAL;
+	bytes[0] = ICE1712_PHASE88_OUTPUT_PAGE;
+	bytes[1] = (spec->pcf8575_data & 0xf0) | chip_mask;
+	snd_i2c_lock(ice->i2c);
+	err = snd_i2c_sendbytes(spec->i2cdevs[EWS_I2C_PCF2], bytes, 2);
+	snd_i2c_unlock(ice->i2c);
+	if (err != 2) {
+		dev_err(ice->card->dev,
+			"AK4524 chip select failed (addr 0x%02x, err %d)\n",
+			spec->i2cdevs[EWS_I2C_PCF2]->addr, err);
+		return -EIO;
+	}
+	spec->pcf8575_data = bytes[1];
+	return 0;
+}
