From ad0f14e94f2c5f901d76611f81283f9274613773 Mon Sep 17 00:00:00 2001
From: root <root@debian.lab.local>
Date: Tue, 13 Oct 2026 17:16:26 +0200
Subject: [PATCH 1/5] ASoC: ice1712: fix PHASE 88 chip select expander address

The TerraTec PHASE 88 (subvendor 0x3b155111) is described as an EWS88MT
variant, so the driver creates the pair of PCF8574 expanders of that
board at 7-bit 0x23/0x24 and probes the front module by reading the
output expander at 0x24.  On the PHASE 88 that read NACKs and the whole
probe fails with:

  snd_ice1712 0000:03:02.0: AK4524 chip select failed, check cable to the front module
  snd_ice1712 0000:03:02.0: probe with driver snd_ice1712 failed with error -5

A read-only survey of the I2C bus (START + address + STOP, the same
sequence the Terratec Windows driver uses for board detection) shows
that the PHASE 88 answers on 7-bit 0x20 (CS8404) and 7-bit 0x21 only;
0x23 and 0x24 do not exist on this board.

The Windows driver (ews88wdm.sys) agrees: it detects the board by
probing 8-bit 0x44, 0x48 and 0x42 and for a PHASE 88 (subsystem 0x1151
and 0xf151) it expects the "type 8" result, whose chip select routine
writes two bytes to 8-bit 0x42: a page byte 0x01 followed by a data byte
that holds the active-low AK4524 chip selects in bits 0-3 and the board
flags in bits 4-7, with flag 0x20 permanently asserted.  That expander is
write-only for the driver - the flag byte is always composed from driver
state, never read back over I2C - so keep a shadow copy of it here as
well.

Add snd_ice1712_phase88_chip_select() doing that two byte write, dispatch
to it from snd_ice1712_ews88mt_chip_select() for the PHASE 88, create
only the CS8404 and the chip select expander for this subvendor, and drop
the "Input/Output Sensitivity Switch" controls which are wired to the
missing 0x23/0x24 expanders (the Windows driver no-ops the input
sensitivity for type 8 boards, too).

With this the PHASE 88 probes and enumerates as "TerraTec Phase88" and
the multi-track PCM reaches RUNNING.
---
 sound/pci/ice1712/ews.c | 61 +++++++++++++++++++++++++++++++++++++++--
 sound/pci/ice1712/ews.h | 15 ++++++++++
 2 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/sound/pci/ice1712/ews.c b/sound/pci/ice1712/ews.c
index 1dffcb011..74eda4999 100644
--- a/sound/pci/ice1712/ews.c
+++ b/sound/pci/ice1712/ews.c
@@ -32,6 +32,7 @@ enum {
 /* additional i2c devices for EWS boards */
 struct ews_spec {
 	struct snd_i2c_device *i2cdevs[3];
+	unsigned char pcf8575_data;	/* PHASE 88: shadow of the expander flags */
 };
 
 /*
@@ -128,12 +129,46 @@ static struct snd_i2c_bit_ops snd_ice1712_ewx_cs8427_bit_ops = {
  * AK4524 access
  */
 
+/*
+ * PHASE 88 AK4524 chip select
+ *
+ * Contrary to the EWS88MT the chip select byte of the PHASE 88 cannot be
+ * read back: the expander is only ever written by the original Windows
+ * driver, which composes the byte from its own state.  Therefore keep a
+ * shadow copy of the flag bits and always write the complete value.
+ */
+static int snd_ice1712_phase88_chip_select(struct snd_ice1712 *ice, int chip_mask)
+{
+	struct ews_spec *spec = ice->spec;
+	unsigned char bytes[2];
+	int err;
+
+	if (snd_BUG_ON(chip_mask < 0 || chip_mask > 0x0f))
+		return -EINVAL;
+	bytes[0] = ICE1712_PHASE88_OUTPUT_PAGE;
+	bytes[1] = (spec->pcf8575_data & 0xf0) | chip_mask;
+	snd_i2c_lock(ice->i2c);
+	err = snd_i2c_sendbytes(spec->i2cdevs[EWS_I2C_PCF2], bytes, 2);
+	snd_i2c_unlock(ice->i2c);
+	if (err != 2) {
+		dev_err(ice->card->dev,
+			"AK4524 chip select failed (addr 0x%02x, err %d)\n",
+			spec->i2cdevs[EWS_I2C_PCF2]->addr, err);
+		return -EIO;
+	}
+	spec->pcf8575_data = bytes[1];
+	return 0;
+}
+
 /* AK4524 chip select; address 0x48 bit 0-3 */
 static int snd_ice1712_ews88mt_chip_select(struct snd_ice1712 *ice, int chip_mask)
 {
 	struct ews_spec *spec = ice->spec;
 	unsigned char data, ndata;
 
+	if (ice->eeprom.subvendor == ICE1712_SUBDEVICE_PHASE88)
+		return snd_ice1712_phase88_chip_select(ice, chip_mask);
+
 	if (snd_BUG_ON(chip_mask < 0 || chip_mask > 0x0f))
 		return -EINVAL;
 	snd_i2c_lock(ice->i2c);
@@ -458,9 +493,25 @@ static int snd_ice1712_ews_init(struct snd_ice1712 *ice)
 		}
 		snd_ice1712_6fire_write_pca(ice, PCF9554_REG_CONFIG, 0x80);
 		break;
+	case ICE1712_SUBDEVICE_PHASE88:
+		err = snd_i2c_device_create(ice->i2c, "CS8404",
+					    ICE1712_EWS88MT_CS8404_ADDR,
+					    &spec->i2cdevs[EWS_I2C_CS8404]);
+		if (err < 0)
+			return err;
+		err = snd_i2c_device_create(ice->i2c, "Output expander",
+					    ICE1712_PHASE88_OUTPUT_ADDR,
+					    &spec->i2cdevs[EWS_I2C_PCF2]);
+		if (err < 0)
+			return err;
+		spec->pcf8575_data = ICE1712_PHASE88_OUTPUT_INIT;
+		/* Check if the chip select expander is present */
+		err = snd_ice1712_ews88mt_chip_select(ice, 0x0f);
+		if (err < 0)
+			return err;
+		break;
 	case ICE1712_SUBDEVICE_EWS88MT:
 	case ICE1712_SUBDEVICE_EWS88MT_NEW:
-	case ICE1712_SUBDEVICE_PHASE88:
 	case ICE1712_SUBDEVICE_TS88:
 
 		err = snd_i2c_device_create(ice->i2c, "CS8404",
@@ -982,9 +1033,15 @@ static int snd_ice1712_ews_add_controls(struct snd_ice1712 *ice)
 				return err;
 		}
 		break;
+	case ICE1712_SUBDEVICE_PHASE88:
+		/*
+		 * The PHASE 88 has neither the input sensitivity expander on
+		 * 0x23 nor the output expander on 0x24 of the EWS88MT, so the
+		 * corresponding switches must not be created here.
+		 */
+		break;
 	case ICE1712_SUBDEVICE_EWS88MT:
 	case ICE1712_SUBDEVICE_EWS88MT_NEW:
-	case ICE1712_SUBDEVICE_PHASE88:
 	case ICE1712_SUBDEVICE_TS88:
 		err = snd_ctl_add(ice->card, snd_ctl_new1(&snd_ice1712_ews88mt_input_sense, ice));
 		if (err < 0)
diff --git a/sound/pci/ice1712/ews.h b/sound/pci/ice1712/ews.h
index aec8dc69a..c047b8d25 100644
--- a/sound/pci/ice1712/ews.h
+++ b/sound/pci/ice1712/ews.h
@@ -58,6 +58,21 @@ extern struct snd_ice1712_card_info snd_ice1712_ews_cards[];
 #define ICE1712_EWS88MT_OUTPUT_SENSE	0x40	/* mask */
 #define ICE1712_EWS88D_PCF_ADDR		(0x40>>1)
 
+/*
+ * TerraTec PHASE 88 configuration definitions
+ *
+ * The PHASE 88 is derived from the EWS88MT but it does not carry the two
+ * PCF8574 expanders at 0x23/0x24.  The AK4524 chip selects are driven by a
+ * 16-bit output expander answering at the 8-bit address 0x42, programmed
+ * with a two byte transfer: an address/page byte followed by the data byte
+ * holding the chip select bits (0-3, active low) and the board flags.
+ * This matches the "type 8" code path of the Terratec Windows driver for
+ * subsystem 0x1151 (PHASE 88) and 0xf151 (PHASE 88 master).
+ */
+#define ICE1712_PHASE88_OUTPUT_ADDR	(0x42>>1)
+#define ICE1712_PHASE88_OUTPUT_PAGE	0x01	/* first byte of the transfer */
+#define ICE1712_PHASE88_OUTPUT_INIT	0x20	/* flags kept asserted (bits 4-7) */
+
 /* TerraTec DMX 6Fire configuration definitions */
 #define ICE1712_6FIRE_AK4524_CS_MASK	0x07	/* AK4524 chip select #1-#3 */
 #define ICE1712_6FIRE_RW		0x08	/* read/write switch for i2c; high = write  */
-- 
