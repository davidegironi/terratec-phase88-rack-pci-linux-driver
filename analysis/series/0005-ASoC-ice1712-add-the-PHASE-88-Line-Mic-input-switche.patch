From f15b12d5a1a7bc817982779a4ec4ca3030b2b0cb Mon Sep 17 00:00:00 2001
From: root <root@debian.lab.local>
Date: Fri, 16 Oct 2026 09:35:33 +0200
Subject: [PATCH 5/5] ASoC: ice1712: add the PHASE 88 Line/Mic input switches

The mixer of the original Terratec drivers offers a "Line/Mic 1/2 ... 7/8"
switch for every pair of analog inputs; it engages the input
preamplifier that a microphone needs.  Without it a microphone stays about
30 dB below the level the Windows mixer delivers, so the channels the
microphone is connected to look dead.

The setting lives in the four upper bits of the second expander register
that the previous commit initialises.  With a microphone on input 7 the
level of that pair rises by roughly 30 dB when bit 4 is set; the other
three bits could not be measured because no source was attached to the
remaining pairs, so they are assumed to keep the same order, from the last
pair to the first one.  The register is write-only, so the value is
composed from the shadow copy that the chip select code maintains.

The switches are created for the PHASE 88 only.  The EWS88MT and the EWS88D
keep their "Input Sensitivity" switches, which are driven by a PCF8575
that these boards carry and the PHASE 88 does not.
---
 sound/pci/ice1712/ews.c | 100 +++++++++++++++++++++++++++++++++++++++-
 sound/pci/ice1712/ews.h |   3 +-
 2 files changed, 101 insertions(+), 2 deletions(-)

diff --git a/sound/pci/ice1712/ews.c b/sound/pci/ice1712/ews.c
index 7878d5ef3..07664277f 100644
--- a/sound/pci/ice1712/ews.c
+++ b/sound/pci/ice1712/ews.c
@@ -181,6 +181,96 @@ static int snd_ice1712_phase88_chip_select(struct snd_ice1712 *ice, int chip_mas
 	return err;
 }
 
+/*
+ * PHASE 88: Line/Mic select of the four analog input pairs
+ *
+ * The Terratec mixers of the original operating systems offer a "Line/Mic
+ * 1/2 ... 7/8" switch for every pair of the AK4524 codecs; the setting is
+ * kept in the second register of the chip select expander.
+ *
+ * With a microphone on input 7 the level of that pair rises by roughly
+ * 30 dB when bit 4 (0x10) of this register is set, while bits 5 ... 7 do
+ * not change anything that could be measured on the other pairs - only the
+ * pair with the microphone attached could be verified.  The register is
+ * write-only, so the bits are assumed to be ordered from the last pair to
+ * the first one: 0x10 selects the microphone of pair 7/8, 0x80 the one of
+ * pair 1/2.
+ */
+static int snd_ice1712_phase88_linemic_info(struct snd_kcontrol *kcontrol,
+					    struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_BOOLEAN;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 1;
+	return 0;
+}
+
+static int snd_ice1712_phase88_linemic_get(struct snd_kcontrol *kcontrol,
+					   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_ice1712 *ice = snd_kcontrol_chip(kcontrol);
+	struct ews_spec *spec = ice->spec;
+
+	ucontrol->value.integer.value[0] =
+		!!(spec->pcf8575_input & (0x80 >> kcontrol->private_value));
+	return 0;
+}
+
+static int snd_ice1712_phase88_linemic_put(struct snd_kcontrol *kcontrol,
+					   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_ice1712 *ice = snd_kcontrol_chip(kcontrol);
+	struct ews_spec *spec = ice->spec;
+	unsigned char bit = 0x80 >> kcontrol->private_value;
+	unsigned char val = ucontrol->value.integer.value[0] ?
+		spec->pcf8575_input | bit : spec->pcf8575_input & ~bit;
+	int err;
+
+	if (val == spec->pcf8575_input)
+		return 0;
+	err = snd_ice1712_phase88_write(ice, ICE1712_PHASE88_INPUT_PAGE, val);
+	if (err < 0)
+		return err;
+	spec->pcf8575_input = val;
+	return 1;
+}
+
+static const struct snd_kcontrol_new snd_ice1712_phase88_linemic_ctls[] = {
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Line/Mic 1/2 Switch",
+		.info = snd_ice1712_phase88_linemic_info,
+		.get = snd_ice1712_phase88_linemic_get,
+		.put = snd_ice1712_phase88_linemic_put,
+		.private_value = 0,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Line/Mic 3/4 Switch",
+		.info = snd_ice1712_phase88_linemic_info,
+		.get = snd_ice1712_phase88_linemic_get,
+		.put = snd_ice1712_phase88_linemic_put,
+		.private_value = 1,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Line/Mic 5/6 Switch",
+		.info = snd_ice1712_phase88_linemic_info,
+		.get = snd_ice1712_phase88_linemic_get,
+		.put = snd_ice1712_phase88_linemic_put,
+		.private_value = 2,
+	},
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Line/Mic 7/8 Switch",
+		.info = snd_ice1712_phase88_linemic_info,
+		.get = snd_ice1712_phase88_linemic_get,
+		.put = snd_ice1712_phase88_linemic_put,
+		.private_value = 3,
+	},
+};
+
 /* AK4524 chip select; address 0x48 bit 0-3 */
 static int snd_ice1712_ews88mt_chip_select(struct snd_ice1712 *ice, int chip_mask)
 {
@@ -1070,8 +1160,16 @@ static int snd_ice1712_ews_add_controls(struct snd_ice1712 *ice)
 		/*
 		 * The PHASE 88 has neither the input sensitivity expander on
 		 * 0x23 nor the output expander on 0x24 of the EWS88MT, so the
-		 * corresponding switches must not be created here.
+		 * corresponding switches must not be created here; instead
+		 * the Line/Mic select of the codec pairs is offered.
 		 */
+		for (idx = 0; idx < ARRAY_SIZE(snd_ice1712_phase88_linemic_ctls); idx++) {
+			err = snd_ctl_add(ice->card,
+					snd_ctl_new1(&snd_ice1712_phase88_linemic_ctls[idx],
+						   ice));
+			if (err < 0)
+				return err;
+		}
 		break;
 	case ICE1712_SUBDEVICE_EWS88MT:
 	case ICE1712_SUBDEVICE_EWS88MT_NEW:
diff --git a/sound/pci/ice1712/ews.h b/sound/pci/ice1712/ews.h
index f0cd01bad..48b19c133 100644
--- a/sound/pci/ice1712/ews.h
+++ b/sound/pci/ice1712/ews.h
@@ -78,7 +78,8 @@ extern struct snd_ice1712_card_info snd_ice1712_ews_cards[];
  * once while they initialise a "type 8" board ({0x03, 0x00} written to
  * 8-bit 0x42).  The latch of the expander is undefined after power on and
  * the AK4524 codecs stay silent when it is left alone, so it has to be
- * written before the codecs are set up.
+ * written before the codecs are set up.  Its four upper bits select either
+ * the line input or the microphone input of the four codec pairs.
  */
 #define ICE1712_PHASE88_INPUT_PAGE	0x03
 #define ICE1712_PHASE88_INPUT_INIT	0x00
