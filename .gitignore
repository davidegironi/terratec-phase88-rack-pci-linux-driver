# Kernel sources and archives are third-party/generated material; keep them out
# of git (including extracted versioned source trees such as linux-6.18.58).
/kernel/
# driver/ is vendor binaries (9 M) - only its provenance notes are tracked, so
# the pattern must not exclude the directory itself
/driver/*
!/driver/README.md
/analysis/baseline/
/logs/
# scratch symlinks into logs/
follow-*
# the self-contained 280 MB bundle (full kernel history) - keep it as a file,
# do not put it in the repo; the 12 KB patch-only bundles above ARE tracked
/archive/phase88-full-history.bundle
# private submission correspondence (owner-only; never commit)
/submission/private-mail/
# build leftovers
*.o
*.ko
*.mod
*.mod.c
.modules.cmdmod
